<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadados do widget (seções 3 e 29 do briefing). minWidth/minHeight em modo
  pequeno; o Glance (ver VersiculoWidget.kt) escolhe entre pequeno/médio/
  grande via SizeMode.Responsive conforme o usuário redimensiona
  (resizeMode abaixo). updatePeriodMillis fica como um fallback de baixa
  frequência — o controle real de "a cada 30/60 min" é feito pelo
  WorkManager (WidgetUpdateWorker), que respeita a preferência do usuário
  dentro dos limites do Android.

  Alguns aparelhos atuais aceitam widgets na tela de bloqueio; a categoria
  keyguard torna este widget elegível nesses aparelhos. A escolha final de
  exibi-lo ainda depende do sistema e do usuário.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:updatePeriodMillis="1800000"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description" />
